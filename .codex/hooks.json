{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_context.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\session_context.py\"",
            "timeout": 5,
            "statusMessage": "Loading portable Codex guidance"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/command_policy.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\command_policy.py\"",
            "timeout": 5,
            "statusMessage": "Checking destructive-command policy"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/secret_guard.py\"",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\secret_guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking for committed secrets"
          }
        ]
      }
    ]
  }
}

